#!/usr/bin/env bash
# Grove Pre-commit Hook
# Materializes files from the graph and runs validation tools

set -e

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Configuration
GROVE_DB_PATH="${GROVE_DB_PATH:-/tmp/grove-mcp.db}"
VERBOSE_FLAG=""
if [[ "$1" == "--verbose" || "$1" == "-v" ]]; then
    VERBOSE_FLAG="--verbose"
fi

echo -e "${YELLOW}Running Grove pre-commit hook...${NC}"

# Check if bun is available
if ! command -v bun &> /dev/null; then
    echo -e "${RED}Error: bun is not installed or not in PATH${NC}"
    echo "Please install bun: curl -fsSL https://bun.sh/install | bash"
    exit 1
fi

# Run the pre-commit hook
if bun run src/pre-commit.ts $VERBOSE_FLAG; then
    echo -e "${GREEN}✓ Pre-commit validation passed${NC}"
    exit 0
else
    exit_code=$?
    echo -e "${RED}✗ Pre-commit validation failed${NC}"
    echo ""
    echo "Please fix the errors above and try again."
    echo ""
    echo "To skip this check (not recommended):"
    echo "  git commit --no-verify"
    exit $exit_code
fi
